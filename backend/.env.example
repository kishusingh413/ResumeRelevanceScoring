DEBUG=1
SECRET_KEY=local-dev-only-change-me

# Paste one key. The provider is chosen from the key itself.
# Gemini keys start with AQ. or AIza. OpenAI keys start with sk-.
API_KEY=

# Optional model override. Leave empty to use the provider default
# (gemini-3.5-flash-lite or gpt-4o-mini).
GPT_MODEL=

# Inside the backend container, Tesseract is already on PATH.
TESSERACT_CMD=tesseract
